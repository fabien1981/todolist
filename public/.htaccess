RewriteEngine On
RewriteBase /todolist/public/

# Rediriger toutes les requêtes vers index.php sauf si c'est un fichier ou dossier existant
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php?fichier=$1 [QSA,L]

# ✅ S'assurer que Apache transmet bien Authorization à PHP
SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
SetEnvIf Authorization "(.*)" REDIRECT_HTTP_AUTHORIZATION=$1
